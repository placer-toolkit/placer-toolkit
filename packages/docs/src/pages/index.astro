---
import Page from "../layouts/Page.astro";

import CTAFooter from "../components/CTAFooter.astro";
import FeatureTiles from "../components/FeatureTiles.astro";
import FeatureTile from "../components/FeatureTile.astro";
import FrameworkAgnosticDesign from "../components/FrameworkAgnosticDesign.astro";
import Heading from "../components/Heading.astro";
import IconGrid from "../components/IconGrid.astro";
import LandingCTA from "../components/LandingCTA.astro";
import Showcase from "../components/Showcase.astro";

import EntirelyNative from "../components/animations/EntirelyNative.astro";
import FullyAccessible from "../components/animations/FullyAccessible.astro";
import GloballyReady from "../components/animations/GloballyReady.astro";

import "../styles/catalog.css";
import "../styles/overrides/home-override.css";
import "../styles/overrides/landing-override.css";
---

<script>
    import "../scripts/navigation-bar-opacity.ts";
</script>

<Page title="Placer Toolkit" noSidebar noBanner showFooter hero>
    <div class="landing-page">
        <LandingCTA />

        <section aria-labelledby="what-is-placer-toolkit">
            <Heading level="2">What is Placer Toolkit?</Heading>

            <p>
                <strong>Placer Toolkit</strong>{" "}
                <span class="ipa" lang="en-fonipa">/ˈplækər ˈtuːlkɪt/</span> is an
                open‐source web component library that lets you build websites with
                any framework—or with none at all.
            </p>

            <FeatureTiles>
                <FeatureTile
                    label="Entirely native"
                    icon="puzzle-piece"
                    href="/docs/get-started/usage"
                    orientation="horizontal"
                >
                    <EntirelyNative slot="image" />
                    Built with web standards, Placer Toolkit works in any framework—or
                    none at all.{" "}
                    <em>No locking in, no compromises.</em>
                </FeatureTile>
                <FeatureTile
                    label="Fully accessible"
                    icon="universal-access"
                    href="/docs/legal/accessibility"
                >
                    <FullyAccessible slot="image" />
                    Accessibility is our standard—built into every component.{" "}
                    <em>It works for everyone, everywhere.</em>
                </FeatureTile>
                <FeatureTile
                    label="Hassle‐free privacy"
                    icon="shield-halved"
                    href="/docs/legal/gdpr"
                >
                    No trackers, no cookies, no worries. Locally hosted and
                    GDPR‐compliant.{" "}
                    <em>Privacy by design.</em>
                </FeatureTile>
                <FeatureTile
                    label="Flexible"
                    icon="paintbrush"
                    href="/docs/get-started/customisation"
                >
                    Easily restyle, customise and adapt components to match your
                    design.{" "}
                    <em>Your website, your rules.</em>
                </FeatureTile>
                <FeatureTile
                    label="Globally ready"
                    icon="globe"
                    href="/docs/get-started/localisation"
                    orientation="horizontal"
                >
                    <GloballyReady slot="image" />
                    With 75 locales out‐of‐the‐box and the ability to add more any
                    time.{" "}
                    <em>Your website speaks every language.</em>
                </FeatureTile>
                <FeatureTile
                    label="Minimal overhead"
                    icon="feather"
                    href="/docs/get-started/installation"
                >
                    No unnecessary dependencies, no bloat. Only what you
                    actually need.{" "}
                    <em>Lean, fast, maintainable.</em>
                </FeatureTile>
            </FeatureTiles>
        </section>

        <section aria-labelledby="zero-lockin">
            <div
                class="stardust adaptive--zero-lock-in"
                style="
                    --stardust-color: var(--pc-color-red-60);
                    opacity: 0.5;
                    transform: scaleX(1.5) scaleY(1.5) rotate(-7deg);
                "
            >
            </div>
            <div
                class="stardust adaptive--zero-lock-in"
                style="
                    --stardust-color: var(--pc-color-red-60);
                    opacity: 0.25;
                    transform: scaleX(2.5) scaleY(2) rotate(-7deg);
                "
            >
            </div>

            <Heading level="2">Zero lock‐in</Heading>

            <p>
                Whether you use React, Vue, Angular, Svelte, any other framework
                or no framework at all, Placer Toolkit integrates seamlessly. No
                proprietary runtimes, no hidden dependencies—just the tools you
                need, right where you need them.
            </p>

            <FrameworkAgnosticDesign />
        </section>

        <section aria-labelledby="design-at-the-speed-of-thought">
            <Heading level="2">Design at the speed of thought</Heading>

            <p>
                Placer Toolkit turns complex styling into a series of
                configuration tweaks. Customise your entire aesthetic instantly
                via CSS variables, or leverage our high‐fidelity, built‐in
                themes and colour palettes to get from prototype to production
                in minutes.
            </p>

            <pc-button
                class="learn-more-button"
                appearance="primary"
                variant="filled"
                href="/docs/get-started/customisation"
            >
                Learn more
                <pc-icon
                    class="arrow-right-move"
                    library="default"
                    icon-style="solid"
                    name="chevron-right"
                    slot="suffix"></pc-icon>
            </pc-button>

            <Showcase />
        </section>

        <section aria-labelledby="iconography-without-limitations">
            <div
                class="stardust"
                style="
                    --stardust-color: var(--pc-color-pink-50);
                    opacity: 0.5;
                    transform: scaleX(1.5) scaleY(2.5) rotate(-7deg);
                "
            >
            </div>
            <div
                class="stardust"
                style="
                    --stardust-color: var(--pc-color-pink-50);
                    opacity: 0.25;
                    transform: scaleX(2.5) scaleY(2.5) rotate(7deg);
                "
            >
            </div>

            <Heading level="2">Iconography without limitations</Heading>

            <p>
                Placer Toolkit ships with <a
                    href="https://fontawesome.com"
                    rel="noreferrer noopener"
                    target="_blank"
                >
                    Font Awesome
                </a>, putting 2 100+ free icons at your fingertips. If your
                design requires more, simply link your Pro or Pro+ Kit—or bypass
                the defaults and integrate any icon library you choose.
            </p>

            <pc-button
                class="learn-more-button"
                appearance="primary"
                variant="filled"
                href="/docs/components/icon"
            >
                Learn more
                <pc-icon
                    class="arrow-right-move"
                    library="default"
                    icon-style="solid"
                    name="chevron-right"
                    slot="suffix"></pc-icon>
            </pc-button>

            <IconGrid />
        </section>

        <CTAFooter />
    </div>
</Page>
