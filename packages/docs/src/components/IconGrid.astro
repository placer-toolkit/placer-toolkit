<script>
    interface IconPosition {
        element: HTMLElement;
        x: number;
        y: number;
    }

    function initializeIconGrid() {
        const grid = document.querySelector<HTMLDivElement>(".icon-grid");
        const icons = Array.from(
            document.querySelectorAll<HTMLDivElement>(".icon"),
        );
        const cursorRadius = 160;

        let iconPositions: IconPosition[] = [];
        let ticking = false;
        let mouseX = 0;
        let mouseY = 0;

        const cssPropertyValueExtractor = document.createElement("div");

        cssPropertyValueExtractor.classList.add("pc-visually-hidden");

        document.body.appendChild(cssPropertyValueExtractor);

        function getResolvedPixels(variable: string): number {
            cssPropertyValueExtractor.style.setProperty(
                "position",
                "fixed",
                "important",
            );
            cssPropertyValueExtractor.style.setProperty(
                "padding",
                `var(${variable})`,
                "important",
            );
            cssPropertyValueExtractor.style.pointerEvents = "none";

            const value = getComputedStyle(cssPropertyValueExtractor).padding;

            return parseFloat(value) || 0;
        }

        const observer = new ResizeObserver((entries) => {
            const entry = entries[0];
            const grid = entry.target as HTMLElement;
            const containerWidth = entry.contentRect.width;

            const paddingLeft = getResolvedPixels("--pc-spacing-l");
            const minGap = getResolvedPixels("--pc-spacing-xs") || 4;
            const maxGap = getResolvedPixels("--pc-spacing-m") || 12;
            const iconSize = 32;

            const availableWidth = containerWidth - paddingLeft * 2;
            const comfort = 0.6;
            const threshold = minGap + (maxGap - minGap) * comfort;

            let columns = 1;

            while (true) {
                if (columns > 50) {
                    break;
                }

                const nextColumns = columns + 1;

                const nextGap =
                    (availableWidth - nextColumns * iconSize) /
                    (nextColumns - 1);

                if (nextGap < minGap) {
                    break;
                }

                if (nextGap >= threshold) {
                    columns = nextColumns;

                    continue;
                }

                break;
            }

            const gap =
                columns === 1
                    ? maxGap
                    : Math.min(
                          maxGap,
                          (availableWidth - columns * iconSize) / (columns - 1),
                      );

            const rootFontSize =
                parseFloat(
                    getComputedStyle(document.documentElement).fontSize,
                ) || 16;

            grid.style.setProperty(
                "--calculated-gap",
                `${gap / rootFontSize}rem`,
            );

            const totalVisibleIcons = columns * 5;

            icons.forEach((icon, index) => {
                icon.style.display =
                    index < totalVisibleIcons ? "flex" : "none";
            });

            requestAnimationFrame(() => updatePositions());
        });

        function updatePositions() {
            iconPositions = icons
                .filter((icon) => icon.offsetWidth > 0)
                .map((icon) => {
                    const rect = icon.getBoundingClientRect();

                    return {
                        element: icon,
                        x: rect.left + window.scrollX + rect.width / 2,
                        y: rect.top + window.scrollY + rect.height / 2,
                    };
                });
        }

        function update() {
            iconPositions.forEach((position) => {
                const distance = Math.hypot(
                    mouseX - position.x,
                    mouseY - position.y,
                );
                const influence = Math.max(
                    0,
                    Math.min(1, 1 - distance / cursorRadius),
                );

                position.element.style.setProperty(
                    "--distance",
                    influence.toFixed(2),
                );
            });

            ticking = false;
        }

        function handleMove(x: number, y: number): void {
            mouseX = x + window.scrollX;
            mouseY = y + window.scrollY;

            if (!ticking) {
                requestAnimationFrame(update);
                ticking = true;
            }
        }

        const scrollHandler = () => updatePositions();
        const resizeHandler = () => updatePositions();
        const pointerHandler = (event: PointerEvent) =>
            handleMove(event.clientX, event.clientY);

        window.addEventListener("scroll", scrollHandler, { passive: true });
        window.addEventListener("resize", resizeHandler);
        window.addEventListener("pointermove", pointerHandler, {
            passive: true,
        });

        if (grid) {
            observer.observe(grid);
        }

        requestAnimationFrame(() => {
            updatePositions();
        });

        return () => {
            window.removeEventListener("scroll", scrollHandler);
            window.removeEventListener("resize", resizeHandler);
            window.removeEventListener("pointermove", pointerHandler);

            observer.disconnect();
            cssPropertyValueExtractor.remove();
        };
    }

    let cleanup: (() => void) | undefined;

    document.addEventListener("astro:page-load", () => {
        cleanup = initializeIconGrid();
    });

    document.addEventListener("astro:after-swap", () => {
        if (cleanup) {
            cleanup();
        }
    });
</script>

