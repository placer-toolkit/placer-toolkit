<script>
    class FadHeightSync extends HTMLElement {
        private observer: ResizeObserver | null = null;

        connectedCallback() {
            const codeBlock = this.querySelector(
                ".framework-agnostic-design .code-block-container",
            );
            const preview = this.querySelector(".preview");

            if (!codeBlock || !preview) {
                return;
            }

            this.observer = new ResizeObserver((entries) => {
                for (let entry of entries) {
                    const height = entry.contentRect.height;

                    if (height > 0) {
                        (codeBlock as HTMLElement).style.blockSize =
                            `${height}px`;
                    }
                }
            });

            this.observer.observe(preview);
        }

        disconnectedCallback() {
            this.observer?.disconnect();
        }
    }

    customElements.define("fad-height-sync", FadHeightSync);
</script>

<style>
    pc-tab-group::part(navigation) {
        margin-block-end: var(--pc-spacing-xs);
    }

    pc-tab-group::part(tabs) {
        border-color: transparent;
    }

    pc-tab-group::part(active-tab-indicator) {
        block-size: 100% !important;
        background-color: color-mix(
            in oklab,
            var(--pc-color-neutral-fill-normal),
            transparent 40%
        );
        border: var(--pc-border-width-s) var(--pc-border-style)
            var(--pc-color-neutral-border-normal);
        border-radius: var(--pc-border-radius-l);
        z-index: -1;
    }

    pc-tab-group pc-tab:focus-visible {
        border-radius: var(--pc-border-radius-l);
        outline: var(--pc-focus-ring);
        outline-offset: calc(-1 * var(--pc-focus-ring-width));
        animation: inset-focus-ring-animation var(--pc-transition-medium)
            cubic-bezier(0.33, 1, 0.68, 1);
    }

    pc-tab-group pc-tab::part(base) {
        display: flex;
        flex-direction: column;
        gap: var(--pc-spacing-l);
        padding-block: var(--pc-spacing-s);
        inline-size: 6rem;
        font-size: var(--pc-font-size-smaller);
    }

    pc-tab-group pc-tab[aria-selected="true"]::part(base) {
        font-weight: var(--pc-font-weight-bold);
    }

    pc-tab-group pc-tab svg {
        inline-size: 3rem;
        block-size: 3rem;
        border-radius: 0;
        opacity: 0.6;
        transition: opacity var(--pc-transition-medium) ease-in-out;
    }

    pc-tab-group pc-tab[aria-selected="true"] svg {
        opacity: 1;
    }

    pc-tab-group pc-tab-panel {
        padding-block-end: 0;
    }

    .framework-agnostic-design {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--pc-spacing-xl);
        inline-size: 100%;
    }

    .framework-agnostic-design :global(.code-block-container) {
        display: flex;
        flex-direction: column;
        grid-column: span 2;
        block-size: 100%;
    }

    .framework-agnostic-design :global(.code-block) {
        block-size: 100%;
        max-block-size: 100%;
        background-color: color-mix(
            in oklab,
            var(--pc-color-surface-raised),
            transparent 20%
        );
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border-radius: var(--pc-border-radius-xl);
        overflow: hidden;
    }

    .framework-agnostic-design :global(.code-block pre.shiki) {
        block-size: 100%;
        border-radius: var(--pc-border-radius-xl);
        overflow: auto;
    }

    .framework-agnostic-design :global(.code-block pre.shiki:focus-visible) {
        outline: var(--pc-focus-ring);
        outline-offset: calc(-1 * var(--pc-focus-ring-width));
        animation: inset-focus-ring-animation var(--pc-transition-medium)
            cubic-bezier(0.33, 1, 0.68, 1);
    }

    .framework-agnostic-design :global(.code-block pre .line:last-child) {
        padding-block-end: var(--pc-spacing-l);
    }

    .framework-agnostic-design
        :global(.code-block pc-copy-button::part(button)) {
        background-color: transparent;
    }

    @media (hover: hover) {
        .framework-agnostic-design
            :global(.code-block pc-copy-button::part(button):hover) {
            background-color: color-mix(
                in oklab,
                color-mix(
                    in oklab,
                    var(--pc-color-surface-raised),
                    transparent 60%
                ),
                var(--pc-color-mix-hover)
            );
        }
    }

    .framework-agnostic-design
        :global(.code-block pc-copy-button::part(button):active) {
        background-color: color-mix(
            in oklab,
            color-mix(
                in oklab,
                var(--pc-color-surface-raised),
                transparent 60%
            ),
            var(--pc-color-mix-active)
        );
    }

    .preview {
        display: flex;
        align-items: center;
        justify-content: center;
        block-size: fit-content;
        background-color: var(--pc-color-surface-lowered);
        border: var(--pc-border-width-s) var(--pc-border-style)
            var(--pc-color-surface-border);
        border-radius: var(--pc-border-radius-xl);
        overflow: hidden;
    }

    @keyframes inset-focus-ring-animation {
        0% {
            outline-width: 0;
            outline-offset: 0;
        }

        50% {
            outline-width: calc(var(--pc-focus-ring-width) * 2);
            outline-offset: calc(-1 * (var(--pc-focus-ring-width) * 2));
        }

        100% {
            outline-width: var(--pc-focus-ring-width);
            outline-offset: calc(-1 * var(--pc-focus-ring-width));
        }
    }

    @media screen and (max-width: 1350px) {
        .framework-agnostic-design {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .framework-agnostic-design :global(.code-block-container) {
            grid-column: 1;
        }
    }

    @media screen and (max-width: 768px) {
        .framework-agnostic-design {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }
    }
</style>
