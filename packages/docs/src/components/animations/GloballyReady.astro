<svg
    xmlns="http://www.w3.org/2000/svg"
    height="100"
    viewBox="0 0 100 100"
    fill="none"
>
    <g
        class="skeleton"
        stroke="var(--pc-color-primary-border-quiet)"
        stroke-width="4"
        stroke-linecap="round"
    >
        <circle cx="50" cy="50" r="48"></circle>
        <path d="M50 2V98"></path>
        <path d="M2 50L98 50"></path>
        <path d="M10 25H90"></path>
        <path d="M10 75H90"></path>
        <path d="M50 2C50 2 25 15 25 50C25 85 50 98 50 98"></path>
        <path d="M50 2C50 2 75 15 75 50C75 85 50 98 50 98"></path>
    </g>

    <g
        class="pulses"
        stroke="var(--pc-color-primary-border-loud)"
        stroke-width="4"
        stroke-linecap="round"
    >
        <circle class="flow-down d1" cx="50" cy="50" r="48" pathLength="100">
        </circle>
        <path class="flow-down d2" d="M50 2V98" pathLength="100"></path>
        <path
            class="flow-down d3"
            d="M50 2C50 2 25 15 25 50C25 85 50 98 50 98"
            pathLength="100"
        >
        </path>

        <path
            class="flow-up u1"
            d="M50 2C50 2 75 15 75 50C75 85 50 98 50 98"
            pathLength="100"
        >
        </path>
    </g>
</svg>

<style>
    svg .flow-down,
    svg .flow-up {
        animation-play-state: paused;
    }

    :global(.grid-tiles .grid-tile:hover) svg .flow-down,
    :global(.grid-tiles .grid-tile:focus-within) svg .flow-down,
    :global(.grid-tiles .grid-tile:hover) svg .flow-up,
    :global(.grid-tiles .grid-tile:focus-within) svg .flow-up {
        animation-play-state: running;
    }

    .pulses .flow-down,
    .pulses .flow-up {
        stroke-dasharray: 0 100;
        stroke-linecap: round;
        animation-timing-function: cubic-bezier(0.45, 0.05, 0.55, 0.95);
        animation-iteration-count: infinite;
    }

    .flow-down {
        animation-name: globe-down;
    }

    .flow-up {
        animation-name: globe-up;
    }

    .d1 {
        animation-duration: 4s;
    }

    .d2 {
        animation-duration: 2.5s;
        animation-delay: -0.8s;
    }

    .d3 {
        animation-duration: 3.5s;
        animation-delay: -1.5s;
    }

    .u1 {
        animation-duration: 3s;
        animation-delay: -0.2s;
    }

    @keyframes globe-down {
        0% {
            stroke-dashoffset: 100;
            stroke-dasharray: 0 100;
        }

        20% {
            stroke-dasharray: 20 80;
        }

        80% {
            stroke-dasharray: 20 80;
        }

        100% {
            stroke-dashoffset: 0;
            stroke-dasharray: 0 100;
        }
    }

    @keyframes globe-up {
        0% {
            stroke-dashoffset: 0;
            stroke-dasharray: 0 100;
        }

        20% {
            stroke-dasharray: 20 80;
        }

        80% {
            stroke-dasharray: 20 80;
        }

        100% {
            stroke-dashoffset: 100;
            stroke-dasharray: 0 100;
        }
    }
</style>
