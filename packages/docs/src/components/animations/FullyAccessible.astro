<style>
    .wire-track {
        fill: none;
        stroke: var(--pc-color-neutral-border-loud);
        stroke-width: 2;
        stroke-linecap: round;
    }

    .pulse-line {
        fill: none;
        stroke: var(--pc-color-success-border-loud);
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-dasharray: 30 300;
        stroke-dashoffset: 330;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .node-group path {
        fill: var(--pc-color-neutral-border-loud);
        transition: fill 0.8s ease;
    }

    @media (hover: hover) {
        :global(.grid-tiles .grid-tile:hover) .pulse-line {
            animation: global-flow 5s 1 linear forwards;
        }
    }

    :global(.grid-tiles .grid-tile:focus-within) .pulse-line {
        animation: global-flow 5s 1 linear forwards;
    }

    @media (hover: hover) {
        :global(.grid-tiles .grid-tile:hover) .node-group path {
            animation: global-fill-swap 5s 1 linear forwards;
        }
    }

    :global(.grid-tiles .grid-tile:focus-within) .node-group path {
        animation: global-fill-swap 5s 1 linear forwards;
    }

    @keyframes global-flow {
        0% {
            stroke-dashoffset: 330;
            opacity: 0;
        }

        5% {
            opacity: 1;
        }

        30% {
            stroke-dashoffset: 0;
            opacity: 1;
        }

        31%,
        100% {
            stroke-dashoffset: 0;
            opacity: 0;
        }
    }

    @keyframes global-fill-swap {
        0%,
        29% {
            fill: var(--pc-color-neutral-border-loud);
        }

        30% {
            fill: url(#checkmark-success);
        }

        32%,
        80% {
            fill: url(#checkmark-success);
        }

        95%,
        100% {
            fill: var(--pc-color-neutral-border-loud);
        }
    }
</style>
