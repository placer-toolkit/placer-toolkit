{
  "name": "placer-toolkit",
  "type": "module",
  "version": "1.0.0-alpha.6",
  "description": "A web component library that’s designed to be flexible and accessible. Built with Lit.",
  "keywords": [
    "lit",
    "placer",
    "toolkit",
    "litelement",
    "components",
    "placer-toolkit",
    "web-components",
    "custom-elements"
  ],
  "main": "./dist/placer.js",
  "module": "./dist/placer.js",
  "types": "./dist/placer.d.ts",
  "author": "Placer (maintainer: @randomguy-2650)",
  "license": "MIT",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/placer.d.ts",
      "import": "./dist/placer.js"
    },
    "./cdn/global-shims.js": "./cdn/global-shims.js",
    "./dist/global-shims.js": {
      "types": "./dist/global-shims.d.ts",
      "import": "./dist/global-shims.js"
    },
    "./cdn/placer.js": "./cdn/placer.js",
    "./dist/placer.js": {
      "types": "./dist/placer.d.ts",
      "import": "./dist/placer.js"
    },
    "./cdn/placer-autoloader.js": "./cdn/placer-autoloader.js",
    "./dist/placer-autoloader.js": {
      "types": "./dist/placer-autoloader.d.ts",
      "import": "./dist/placer-autoloader.js"
    },
    "./cdn/custom-elements.json": "./cdn/custom-elements.json",
    "./dist/custom-elements.json": "./dist/custom-elements.json",
    "./cdn/components/*": "./cdn/components/*",
    "./dist/components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./cdn/styles/*": "./cdn/styles/*",
    "./dist/styles/*": "./dist/styles/*",
    "./cdn/translations/*": "./cdn/translations/*",
    "./dist/translations/*": {
      "types": "./dist/translations/*.d.ts",
      "import": "./dist/translations/*.js"
    },
    "./cdn/utilities/*": "./cdn/utilities/*",
    "./dist/utilities/*": {
      "types": "./dist/utilities/*.d.ts",
      "import": "./dist/utilities/*.js"
    }
  },
  "files": [
    "cdn",
    "dist",
    "licenses",
    "LICENSE.md",
    "THIRD-PARTY-NOTICES.txt",
    "README.md"
  ],
  "scripts": {
    "dev": "node ./scripts/build.js --watch",
    "build": "node ./scripts/build.js && pnpm generate_attribution",
    "lint": "tsc --noEmit",
    "format": "prettier --write --log-level=warn .",
    "generate_attribution": "node ./scripts/generate-attribution.js",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/placer-toolkit/placer-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/placer-toolkit/placer-toolkit/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/randomguy2650"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0",
    "@floating-ui/dom": "^1.7.4",
    "composed-offset-position": "^0.0.6",
    "lit": "^3.3.3",
    "nanoid": "^5.1.16",
    "qr-creator": "^1.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "comment-parser": "^1.4.7",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.3.5",
    "glob": "^13.0.0",
    "license-checker": "^25.0.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
